{
  "name": "yawachathub",
  "productName": "YawaChatHub",
  "version": "3.2.5",
  "description": "Единая лента сообщений со стримов (Twitch / YouTube Live / VK Video Live / Kick / TikTok) с озвучкой SAPI, OBS-виджетом и игровым оверлеем. Portable exe и установщик Windows x64.",
  "main": "electron/main.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "yawaside",
  "homepage": "https://github.com/yawaside/Yawachat.test",
  "repository": {
    "type": "git",
    "url": "https://github.com/yawaside/Yawachat.test.git"
  },
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:setup": "electron-builder --win nsis",
    "dist:all": "electron-builder --win"
  },
  "dependencies": {
    "tiktok-live-connector": "^1.2.2",
    "vklive-message-client": "^5.3.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "chat.yawa.hub",
    "productName": "YawaChatHub",
    "copyright": "Copyright © 2026 yawaside",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer-dist/**/*",
      "widget/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "YawaChatHub.exe"
    },
    "nsis": {
      "artifactName": "YawaChatHub-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YawaChatHub",
      "deleteAppDataOnUninstall": false,
      "language": "1049"
    }
  }
}
