{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-ci-x64",
      "displayName": "Windows CI x64 (Ninja, MSVC)",
      "description": "Конфигурация CI: зависимости из native/.deps (Install-ObsDeps.ps1)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/native/.build/windows-ci-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PLATFORM_NAME": "x64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-ci-x64",
      "displayName": "Build yawametrics.dll",
      "configurePreset": "windows-ci-x64"
    }
  ]
}
